# Your wallet's public address — used by scripts to derive the deployer address.
# No private key needed here. Import your key into Foundry's keystore instead:
#   cast wallet import battlechain --interactive
# To find your address, run:
#   cast wallet address --account battlechain 
SENDER_ADDRESS=

# ── Shared demo stake token (pre-allowlisted on the ConfidencePoolFactory) ─────
# The vault seeds itself from this token instead of minting a per-run one, so its
# address is stable and pool creation isn't blocked by the factory's owner-gated
# stake-token allowlist. Leave as-is unless you own the factory and allowlist another.
TOKEN_ADDRESS=0x12EA23f5600d831cEE92cdbfA10F534a5e7BEF39

# ── Filled in after running: just deploy-protocol ─────────────────────────────
VAULT_ADDRESS=

# ── Filled in after running: just create-agreement ────────────────────────────
AGREEMENT_ADDRESS=

# ── Filled in after running: just create-confidence-pool ──────────────────────
CONFIDENCE_POOL_ADDRESS=

# ── Optional: amount to stake with `just stake-confidence` ─────────────────────
# Defaults to the pool's minStake if unset. Must be >= that minimum.
STAKE_AMOUNT=

# ── The asset recovery address (receives returned funds after an attack) ───────
# Set to your wallet address (same as SENDER_ADDRESS for this tutorial)
RECOVERY_ADDRESS=

# ── Testnet Attack Registry address ───────────────────────────────────────────
ATTACK_REGISTRY=0x22134e878c409a0Eab7259d873b38e26Ca966d3C
